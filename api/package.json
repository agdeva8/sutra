{
  "name": "@goalcoach/api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "lsof -ti:3000 | xargs kill -9 2>/dev/null; next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "preflight": "pnpm verify && pnpm tsx scripts/smoke-model.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrate": "tsx db/migrate-from-mongo.ts",
    "migrate:mongo": "tsx db/migrate-from-mongo.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "ai": "^7.0.127",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.40.0",
    "drizzle-zod": "^0.6.0",
    "mongodb": "^6.10.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "or-tools-wasm": "^1.0.0",
    "pg": "^8.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@swc/helpers": "0.5.23",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.0.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "jsdom": "^25.0.0",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}