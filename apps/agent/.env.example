# apps/agent — copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# The app reads os.environ only — no dotenv loader is installed, so a `.env` is
# inert until you load it explicitly:
#
#   cd apps/agent
#   uv run --env-file .env python -m app.tui
#
# or, in a shell:
#
#   set -a; source .env; set +a
#   .venv/bin/python -m app.tui

# ── the model ───────────────────────────────────────────────────────────────
# DeepSeek (OpenAI-compatible). Leave the key blank to run the offline stub.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Generic OpenAI-compatible override — when SUTRA_LLM_API_KEY is set it wins
# over the DeepSeek and OpenAI names above.
#SUTRA_LLM_API_KEY=
#SUTRA_LLM_BASE_URL=
#SUTRA_LLM_MODEL=

# ── LangSmith tracing ───────────────────────────────────────────────────────
# With a key set, every turn lands as one trace: `plan.turn` → the graph nodes
# → `llm.model_call`. Leave the key blank and tracing is inert.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sutra-agent
LANGSMITH_TRACING=true

# Self-hosted or EU instance:
#LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
