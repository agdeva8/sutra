# apps/api — copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#   set -a; source .env; set +a

# ── database ────────────────────────────────────────────────────────────────
# Local Docker Postgres, started from infra/docker-compose.yml. The asyncpg
# driver is added automatically if you paste a bare `postgresql://` URL.
DATABASE_URL=postgresql+asyncpg://sutra:sutra@localhost:5433/sutra
# Optional. Alembic prefers this for DDL; falls back to DATABASE_URL.
#DATABASE_URL_UNPOOLED=

# ── auth ────────────────────────────────────────────────────────────────────
# HMAC key for the guest cookie. Must be >= 32 chars.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Dev personas + GET /auth/dev-login. Anything but "true" makes those routes 404.
ALLOW_DEV_LOGIN=false
# Comma-separated. Empty means "same origin only", which is what apps/web does.
#CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── storage ─────────────────────────────────────────────────────────────────
# Supabase Storage. With SUPABASE_URL blank, uploads fall back to a local
# directory (LOCAL_STORAGE_DIR) so the service runs with no credentials.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=goalcoach
LOCAL_STORAGE_DIR=.data/sources

# ── the planner ─────────────────────────────────────────────────────────────
GOAL_PLANNER_ENABLED=true
# Comma-separated user ids. Empty = everyone (dark-launch switch, HLD §14).
#GOAL_PLANNER_USER_ALLOWLIST=

# ── the model ───────────────────────────────────────────────────────────────
# Read by apps/agent/app/llm/client.py from os.environ — NOT by settings.py,
# so that the model configuration has exactly one home. Leave blank to run the
# agent's offline stub.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Generic OpenAI-compatible override — wins over the names above when set.
#SUTRA_LLM_API_KEY=
#SUTRA_LLM_BASE_URL=
#SUTRA_LLM_MODEL=

# ── tracing ─────────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sutra-agent
LANGSMITH_TRACING=true
