{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "develop_v2": false
    }
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "apps/{api/sutra_api,agentv2}/**"
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/index?__path=/:path*"
    }
  ]
}
